{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": [
            "ES2022"
        ],
        "outDir": "dist",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "rootDir": "..",
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "paths": {
            "@clientfinder/shared": [
                "../shared/src/index.ts"
            ]
        }
    },
    "include": [
        "src/**/*",
        "../shared/src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}