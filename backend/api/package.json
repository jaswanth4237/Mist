{
    "name": "@clientfinder/api",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc",
        "start": "node dist/api/src/server.js",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src --ext .ts",
        "test": "vitest run",
        "test:watch": "vitest",
        "db:generate": "prisma generate",
        "db:migrate": "prisma migrate dev",
        "db:migrate:deploy": "prisma migrate deploy",
        "db:studio": "prisma studio"
    },
    "dependencies": {
        "@clientfinder/shared": "*",
        "@prisma/client": "^5.10.2",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.18.3",
        "express-rate-limit": "^7.2.0",
        "helmet": "^7.1.0",
        "pino": "^8.19.0",
        "pino-pretty": "^11.0.0",
        "uuid": "^11.1.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/node": "^20.11.30",
        "@types/supertest": "^6.0.2",
        "prisma": "^5.10.2",
        "supertest": "^6.3.4",
        "tsx": "^4.7.1",
        "typescript": "^5.3.3",
        "vitest": "^1.4.0"
    }
}
